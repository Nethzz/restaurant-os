{
  "name": "restaurant-os",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:dashboard": "pnpm --filter dashboard web",
    "dev:backend": "cd services/backend && pnpm dev",
    "gen:contract": "cd services/backend && pnpm exec orval --config orval.config.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "test": "pnpm --filter dashboard test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}